# ─────────────────────────────────────────────────────────────
# Email — callback request form (CallbackChip)
# Copy to `.env` and fill in. Never commit the real `.env`.
# ─────────────────────────────────────────────────────────────

# --- SMTP (required to actually send mail) ---
# Without these the app still works; it logs a warning and skips sending.
#
# Gmail / Google Workspace settings:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=solara@supermia.ai
#   SMTP_PASS=<16-character App Password, spaces removed>
# An App Password requires 2-Step Verification to be ON for that account.
# A normal account password will NOT work — Google blocks it.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=solara@supermia.ai
SMTP_PASS=
# true for port 465 (implicit TLS), false for 587/25 (STARTTLS).
# Leave unset to infer from the port.
# SMTP_SECURE=false
# The visible From address. Gmail rewrites this to SMTP_USER unless the address
# is a verified alias on that account, so keep them the same.
SMTP_FROM="Solara <solara@supermia.ai>"

# --- Where admin notifications go ---
EMAIL_ADMIN=solara@supermia.ai

# --- Branding ---
# SITE_URL is used to build absolute links and the email logo URL, so it must
# be the real public origin (no trailing slash).
SITE_URL=https://solara.supermia.ai

# Optional override. Defaults to ${SITE_URL}/images/logo.png (dark wordmark,
# shown on the light email header). Email clients do not render SVG, so this
# must stay a PNG/JPG.
# EMAIL_LOGO_URL=
